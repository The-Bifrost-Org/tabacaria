generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String          @id @default(cuid())
  name           String
  description    String?
  price          Float
  imageUrl       String?
  available      Boolean         @default(true)
  order          Int             @default(0)
  categoryId     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  adminNote      String?
  featured       Boolean         @default(false)
  flashSaleItems FlashSaleItem[]
  category       Category        @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variations     Variation[]
}

model Variation {
  id             String          @id @default(cuid())
  name           String
  price          Float
  available      Boolean         @default(true)
  order          Int             @default(0)
  productId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  imageUrl       String?
  flashSaleItems FlashSaleItem[]
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model StoreConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  type      String
  message   String
  name      String?
  createdAt DateTime @default(now())
  rating    Int?
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Float
  type      String
  active    Boolean   @default(true)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model StoreHours {
  id        String   @id @default(cuid())
  dayOfWeek Int
  openTime  String
  closeTime String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FlashSale {
  id          String          @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       FlashSaleItem[]
}

model FlashSaleItem {
  id            String     @id @default(cuid())
  flashSaleId   String
  productId     String
  variationId   String?
  originalPrice Float
  salePrice     Float
  createdAt     DateTime   @default(now())
  flashSale     FlashSale  @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation     Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
}
